{
  "name": "ROS Workshop (NVIDIA)",

  "dockerComposeFile": [
    "../docker/docker-compose.yaml"
  ],

  "service": "ros_workshop",

  "workspaceFolder": "/root/workshop_ws/src/",

  "customizations": {
    "vscode": {
      "extensions": [
        "ms-iot.vscode-ros",
        "ms-vscode.cpptools",
        "ms-python.python",
        "ms-python.vscode-pylance",
        "ms-vscode.cmake-tools"
      ],
      "settings": {
        "python.defaultInterpreterPath": "/usr/bin/python3",
        "python.analysis.extraPaths": [
          "/opt/ros/humble/lib/python3.10/site-packages",
          "/opt/ros/humble/local/lib/python3.10/dist-packages"
        ],
        "C_Cpp.default.compileCommands": "/root/workshop_ws/build/ttbot/compile_commands.json",
        "C_Cpp.default.includePath": [
          "${workspaceFolder}/**",
          "/opt/ros/humble/include/**"
        ]
      }
    }
  },

  "remoteUser": "root"
}