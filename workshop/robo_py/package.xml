<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>robo_py</name>
  <version>0.1.0</version>
  <description>Trilha Python: nós obstacle_avoider (Aula 1) e route_mapper (Aula 3)</description>
  <maintainer email="grvillela@cos.ufrj.br">Gustavo Rocha Villela</maintainer>
  <license>MIT</license>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>nav_msgs</exec_depend>

  <exec_depend>turtlebot3_gazebo</exec_depend>
  <exec_depend>robo_gazebo</exec_depend>
  <exec_depend>robo_cartographer</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
