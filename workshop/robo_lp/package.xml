<?xml version="1.0"?>
<package format="3">
  <name>robo_lp</name>
  <version>0.1.0</version>
  <description>Robô diferencial com lidar e IMU, mapeamento autônomo com Cartographer</description>
  <maintainer email="grvillela@cos.ufrj.br">Gustavo Rocha Villela</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>nav_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>geometry_msgs</depend>

  <exec_depend>xacro</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>ros_gz_sim</exec_depend>
  <exec_depend>ros_gz_bridge</exec_depend>
  <exec_depend>turtlebot3_cartographer</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
