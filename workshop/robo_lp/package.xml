<?xml version="1.0"?>
<package format="3">
  <name>robo_lp</name>
  <version>0.1.0</version>
  <description>Trilha C++: nó route_mapper, que leva o robô pelo percurso do mapeamento (Aula 3)</description>
  <maintainer email="grvillela@cos.ufrj.br">Gustavo Rocha Villela</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>nav_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>geometry_msgs</depend>

  <exec_depend>robo_gazebo</exec_depend>
  <exec_depend>robo_cartographer</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
