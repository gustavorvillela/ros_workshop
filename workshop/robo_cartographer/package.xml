<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>robo_cartographer</name>
  <version>0.1.0</version>
  <description>SLAM do robô do workshop: configuração do Cartographer e launch que reaproveita o turtlebot3_cartographer</description>
  <maintainer email="grvillela@cos.ufrj.br">Gustavo Rocha Villela</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>turtlebot3_cartographer</exec_depend>
  <exec_depend>nav2_map_server</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
