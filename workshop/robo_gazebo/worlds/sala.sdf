<?xml version="1.0"?>
<sdf version="1.9">
  <world name="sala">
    <!-- Ao declarar sistemas, o Gazebo não carrega os padrões: liste todos os necessários -->
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu"/>

    <light type="directional" name="sol">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <model name="chao">
      <static>true</static>
      <link name="link">
        <collision name="collision"><geometry><plane><normal>0 0 1</normal><size>40 40</size></plane></geometry></collision>
        <visual name="visual"><geometry><plane><normal>0 0 1</normal><size>40 40</size></plane></geometry>
          <material><ambient>0.8 0.8 0.8 1</ambient><diffuse>0.8 0.8 0.8 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="parede_sul">
      <static>true</static>
      <pose>3 -4 0.75 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>14.2 0.2 1.5</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>14.2 0.2 1.5</size></box></geometry>
          <material><ambient>0.7 0.7 0.7 1</ambient><diffuse>0.7 0.7 0.7 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="parede_norte">
      <static>true</static>
      <pose>3 10 0.75 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>14.2 0.2 1.5</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>14.2 0.2 1.5</size></box></geometry>
          <material><ambient>0.7 0.7 0.7 1</ambient><diffuse>0.7 0.7 0.7 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="parede_oeste">
      <static>true</static>
      <pose>-4 3 0.75 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.2 14.2 1.5</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.2 14.2 1.5</size></box></geometry>
          <material><ambient>0.7 0.7 0.7 1</ambient><diffuse>0.7 0.7 0.7 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="parede_leste">
      <static>true</static>
      <pose>10 3 0.75 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.2 14.2 1.5</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.2 14.2 1.5</size></box></geometry>
          <material><ambient>0.7 0.7 0.7 1</ambient><diffuse>0.7 0.7 0.7 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="caixa_central">
      <static>true</static>
      <pose>3 3 0.75 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>2.0 2.0 1.5</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>2.0 2.0 1.5</size></box></geometry>
          <material><ambient>0.7 0.7 0.7 1</ambient><diffuse>0.7 0.7 0.7 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="divisoria">
      <static>true</static>
      <pose>-2 6.5 0.75 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.2 4.0 1.5</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.2 4.0 1.5</size></box></geometry>
          <material><ambient>0.7 0.7 0.7 1</ambient><diffuse>0.7 0.7 0.7 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="coluna">
      <static>true</static>
      <pose>8.5 8.5 0.75 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>1.0 1.0 1.5</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>1.0 1.0 1.5</size></box></geometry>
          <material><ambient>0.7 0.7 0.7 1</ambient><diffuse>0.7 0.7 0.7 1</diffuse></material>
        </visual>
      </link>
    </model>
  </world>
</sdf>
